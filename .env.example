# AyurRaksha headless Next.js — environment variables
#
# Copy to `.env` and fill in for your setup. Every variable is optional for a
# working build: with none set, the app builds statically against its mock
# data. Set WORDPRESS_API_URL to switch to the live headless WordPress backend.

# ── Public (baked into the client bundle) ──────────────────────────────────
# The public domain the frontend is served from. Used for canonicals, the
# sitemap, and robots.txt — NOT the WordPress backend.
NEXT_PUBLIC_SITE_URL=https://ayurrakshaonline.com

# ── WordPress / WooCommerce (server-side, headless backend) ────────────────
# Base of the WordPress REST API. Products/content are read from the PUBLIC
# WooCommerce Store API (wc/store/v1) and the public WP REST API (wp/v2) —
# no consumer keys or auth are required for read access.
# Rank Math SEO metadata comes from the public headless endpoint
# rankmath/v1/getHead (enable "headless_support" in Rank Math settings).
WORDPRESS_API_URL=https://ayur.edigimark.com/wp-json

# ── Optional: authenticated WooCommerce REST API (v3) ──────────────────────
# Only needed if you later call private endpoints (orders, stock writes, etc.).
# Leave unset for a read-only storefront.
# WOOCOMMERCE_API_URL=https://ayur.edigimark.com/wp-json/wc/v3
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
