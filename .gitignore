# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/.next-cache

# Production build (if you build before deploy)
/build

# Env & secrets — never commit live keys
.env
.env.local
.env*.local
.env.development
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage

# Misc
.DS_Store
*.pem
Thumbs.db

# Local editor / tooling
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Source maps & production files
*.tsbuildinfo
next-env.d.ts

# Temporary scratch dirs (e.g. Novamira probes)
.claude-tmp/
